#!/bin/bash
# gemini-sidecar/git-credential-darwin
# @ai-rules:
# 1. [Pattern]: Git credential helper protocol — reads stdin key=value pairs, outputs credentials.
# 2. [Contract]: Called by git via credential."https://github.com/<org>".helper config.
# 3. [Constraint]: Must exit 0 silently if org not in token map (git falls through to next helper).
# 4. [Gotcha]: Token map at /tmp/gh-token-map.json is mode 0600, written by credentials.js.

set -euo pipefail

TOKEN_MAP="${GH_TOKEN_MAP_PATH:-/tmp/gh-token-map.json}"

# Read stdin lines (git credential helper protocol)
declare -A FIELDS
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  FIELDS["$key"]="$value"
done

# Extract org from path (first component before '/')
PATH_VAL="${FIELDS[path]:-}"
ORG="${PATH_VAL%%/*}"

# Lowercase for map lookup
ORG=$(printf '%s' "$ORG" | tr '[:upper:]' '[:lower:]')

[ -z "$ORG" ] && exit 0
[ ! -f "$TOKEN_MAP" ] && exit 0

# Look up token from map via node (JSON parsing)
TOKEN=$(node -e "
  const fs = require('fs');
  try {
    const map = JSON.parse(fs.readFileSync('${TOKEN_MAP}', 'utf8'));
    const entry = map[process.argv[1]] || map._default;
    if (entry && entry.token) process.stdout.write(entry.token);
  } catch {}
" "$ORG" 2>/dev/null)

[ -z "$TOKEN" ] && exit 0

printf 'username=x-access-token\npassword=%s\n\n' "$TOKEN"
